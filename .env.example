# Emtithal — environment variables (template). Copy to .env.local for local dev.
# Never put a real key here. .env* is gitignored except this template.
# AI is server-side only; values are read only under src/lib/ai/.
#
# AI_PROVIDER: anthropic | gemini
# AI_PROVIDER_API_KEY: the selected provider's API key (no provider-specific name)
# AI_MODEL: the model id for the selected provider (never hardcoded in source)

AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
