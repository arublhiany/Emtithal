# Emtithal — environment variables (template)
#
# Copy to .env.local for local development:  cp .env.example .env.local
# Never put real secrets in this file. Real values live only in .env.local
# (untracked) and in the Vercel project settings.
#
# This template is tracked (.gitignore: `.env*` then `!.env.example`). Every
# other .env file stays ignored. See FINALIST_IMPLEMENTATION_LOG.md.

# --- AI provider (server-side only — used from Phase 4 onward) ---------------
# Anthropic API key. Used exclusively in Next.js server routes / server actions.
# Must never be referenced from client components or shipped to the browser.
AI_PROVIDER_API_KEY=

# Anthropic model id, supplied via env — never hardcoded in source. Set the real
# id in .env.local / Vercel only; this template stays blank.
AI_MODEL=
